{
  "expo": {
    "name": "Vegan Bangkok",
    "slug": "vegan-bangkok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "veganbangkok",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.veganbangkok.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you pick a menu photo to scan for vegan dishes.",
          "cameraPermission": "Lets you photograph a menu to scan for vegan dishes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF9EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#141410"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins_400Regular.ttf",
            "./assets/fonts/Poppins_500Medium.ttf",
            "./assets/fonts/Poppins_600SemiBold.ttf",
            "./assets/fonts/Poppins_700Bold.ttf",
            "./assets/fonts/NotoSansThai_400Regular.ttf",
            "./assets/fonts/NotoSansThai_500Medium.ttf",
            "./assets/fonts/NotoSansThai_600SemiBold.ttf",
            "./assets/fonts/NotoSansThai_700Bold.ttf"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "your-org-slug",
          "project": "vegan-bangkok-mobile"
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location sets the walking tour's start point."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "",
      "sentryDsn": "",
      "mapboxToken": ""
    }
  }
}