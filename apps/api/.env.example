# Local dev: the vb-postgres container (see infrastructure-design/infrastructure.md "Local dev")
DATABASE_URL=postgres://vb:vb@localhost:55432/vegan_bangkok
# Gemini — embeddings (search, embed:backfill) + text generation (enrich derive step)
GEMINI_API_KEY=
# Catalog enrichment only (plan 09, `npm run enrich`) — Places API (New) enabled
GOOGLE_PLACES_API_KEY=
# Optional — blank/unset is fine; set on Railway in production
SENTRY_DSN=
# Required only when NODE_ENV=production
CORS_ORIGIN=
# Optional — Thai OCR sidecar for menu-scan (ocr-service/). Unset → in-process Tesseract.js fallback.
OCR_URL=
